# Discord
DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=

# Firebase service account, as a single-line JSON string of the key file.
# On Railway, paste the whole JSON as the value.
FIREBASE_SERVICE_ACCOUNT={


# Watched forums (comma-separated channel ids). At least one is required for the bot to do anything.
WATCHED_SHOWCASE_FORUM_IDS=
WATCHED_COMPETITION_FORUM_IDS=

# Scoring config. Defaults shown.
HELPFUL_EMOJI=✅
MIN_COMMENT_LENGTH=80
MAX_POINTS_PER_THREAD_PER_USER=2

# Where the weekly leaderboard is posted.
LEADERBOARD_CHANNEL_ID=

# Optional. Channel where mods get notified about new showcase/competition posts and
# new posters.
MOD_FEED_CHANNEL_ID=

# Optional. Separate channel for milestone alerts, which are action items rather than
# passive notices. Falls back to MOD_FEED_CHANNEL_ID when unset.
MILESTONE_CHANNEL_ID=

# Optional. Restrict mod-only commands to this role id (in addition to Manage Server).
MOD_ROLE_ID=

# All-time point totals that alert MOD_FEED_CHANNEL_ID. Notification only — no role is
# assigned, rewards are handed out by hand. Defaults shown.
MILESTONE_THRESHOLDS=10,20,40

# Optional. Set to "false" to disable the scheduled weekly leaderboard post.
WEEKLY_POST_ENABLED=true

# Optional defaults for /logovotes and /logopoll (the logo competition). Set these so the
# commands can be run with no arguments; both are overridable per-invocation via options.
# LOGO_COMPETITION_CHANNEL_ID is the forum/media channel (each logo is its own post) or a
# text channel (each logo is a message). LOGO_VOTE_EMOJI is the vote reaction: the :logocomp:
# custom emoji *id* below (matching by id survives a rename), or a name / <:logocomp:id> / a
# unicode emoji.
LOGO_COMPETITION_CHANNEL_ID=1537585946244161677
LOGO_VOTE_EMOJI=1537600958245249154

# Optional. Byte's daily digest: a short, dry end-of-day recap posted in the voice of
# Byte, the sentient 3.5" floppy disk (see src/lib/byte.js for the character). Leads with
# a Claude-written summary of the day's actual chat, followed by template lines for
# tracked events (new builds, feedback points, milestones, first-time posters). Off until DAILY_DIGEST_CHANNEL_ID is set — point it at #general.
# The digest posts via a webhook so it appears as "Byte" with a floppy-disk avatar;
# grant the bot Manage Webhooks on that channel (it falls back to a plain bot message
# without it). DAILY_DIGEST_TIME_UTC is "HH:MM" (UTC). Set DAILY_DIGEST_SKIP_QUIET=true
# to stay silent on days with nothing to report instead of posting a deadpan one-liner.
DAILY_DIGEST_CHANNEL_ID=
DAILY_DIGEST_ENABLED=true
DAILY_DIGEST_TIME_UTC=20:00
DAILY_DIGEST_SKIP_QUIET=false
DAILY_DIGEST_NAME=Byte

# Byte's face. Upload the Byte artwork as a custom emoji on the server, then put its id
# here (bare id, or <:byte:id>, or <a:byte:id> for animated; a unicode emoji also works).
# One value does two jobs: the emoji appears inline wherever Byte signs something (digest
# header + signoff, /gameidea footer), and for a custom emoji its Discord-CDN image is
# used as the digest webhook's avatar automatically. Unset = generic 💾.
# Note: Discord's API doesn't allow STICKERS on webhook posts or slash-command replies,
# so an emoji is the way to give Byte a face; a sticker would post as the plain bot.
BYTE_EMOJI=

# Optional explicit avatar override (a hosted PNG). Takes precedence over the BYTE_EMOJI
# image. Leave empty to derive from BYTE_EMOJI, or a generic floppy image when neither
# is set.
DAILY_DIGEST_AVATAR_URL=

# The chat-recap half of the digest. Needs an Anthropic API key (console.anthropic.com);
# without one the digest still posts, just without the chat summary. One bounded API call
# per day — pennies on the default model, and DAILY_DIGEST_MODEL=claude-haiku-4-5 makes it
# ~5x cheaper. DAILY_DIGEST_CHAT_CHANNEL_IDS is the comma-separated list of channels whose
# chat gets read and summarised; it DEFAULTS TO THE DIGEST CHANNEL ITSELF. Only list
# channels whose contents the whole server may see recapped — never mod or private ones.
ANTHROPIC_API_KEY=
DAILY_DIGEST_MODEL=claude-opus-5
DAILY_DIGEST_CHAT_CHANNEL_IDS=

# /gameidea — Byte's game-idea generator (random ingredient collision developed into a
# pitch). Uses the same ANTHROPIC_API_KEY; without it the command serves the raw mad-lib
# for free. The cooldown is per user (mods bypass); the daily cap bounds total API spend —
# worst case ≈ cap × one small call (about a dollar a day at 30 on the default model;
# GAME_IDEA_MODEL=claude-haiku-4-5 is ~5x cheaper). Defaults shown.
GAME_IDEA_MODEL=claude-opus-5
GAME_IDEA_COOLDOWN_SECONDS=300
GAME_IDEA_DAILY_CAP=30
