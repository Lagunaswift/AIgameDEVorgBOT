# Discord
DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=

# Firebase service account, as a single-line JSON string of the key file.
# On Railway, paste the whole JSON as the value.
FIREBASE_SERVICE_ACCOUNT={


# Watched forums (comma-separated channel ids). At least one is required for the bot to do anything.
WATCHED_SHOWCASE_FORUM_IDS=
WATCHED_COMPETITION_FORUM_IDS=

# Scoring config. Defaults shown.
HELPFUL_EMOJI=✅
MIN_COMMENT_LENGTH=80
MAX_POINTS_PER_THREAD_PER_USER=2

# Where the weekly leaderboard is posted.
LEADERBOARD_CHANNEL_ID=

# Optional. Channel where mods get notified about new showcase/competition posts and
# new posters.
MOD_FEED_CHANNEL_ID=

# Optional. Separate channel for milestone alerts, which are action items rather than
# passive notices. Falls back to MOD_FEED_CHANNEL_ID when unset.
MILESTONE_CHANNEL_ID=

# Optional. Restrict mod-only commands to this role id (in addition to Manage Server).
MOD_ROLE_ID=

# All-time point totals that alert MOD_FEED_CHANNEL_ID. Notification only — no role is
# assigned, rewards are handed out by hand. Defaults shown.
MILESTONE_THRESHOLDS=10,20,40

# Optional. Set to "false" to disable the scheduled weekly leaderboard post.
WEEKLY_POST_ENABLED=true

# Optional defaults for /logovotes and /logopoll (the logo competition). Set these so the
# commands can be run with no arguments; both are overridable per-invocation via options.
# LOGO_COMPETITION_CHANNEL_ID is the forum/media channel (each logo is its own post) or a
# text channel (each logo is a message). LOGO_VOTE_EMOJI is the vote reaction: the :logocomp:
# custom emoji *id* below (matching by id survives a rename), or a name / <:logocomp:id> / a
# unicode emoji.
LOGO_COMPETITION_CHANNEL_ID=1537585946244161677
LOGO_VOTE_EMOJI=1537600958245249154

# Optional. Floppy's daily digest: a short, witty end-of-day summary of server activity
# (new builds, feedback points, milestones, first-time posters), posted in the voice of a
# sentient floppy disk. Off until DAILY_DIGEST_CHANNEL_ID is set — point it at #general.
# The digest posts via a webhook so it appears as "Floppy" with a floppy-disk avatar;
# grant the bot Manage Webhooks on that channel (it falls back to a plain bot message
# without it). DAILY_DIGEST_TIME_UTC is "HH:MM" (UTC). Set DAILY_DIGEST_SKIP_QUIET=true
# to stay silent on days with nothing to report instead of posting a deadpan one-liner.
DAILY_DIGEST_CHANNEL_ID=
DAILY_DIGEST_ENABLED=true
DAILY_DIGEST_TIME_UTC=20:00
DAILY_DIGEST_SKIP_QUIET=false
DAILY_DIGEST_NAME=Floppy
DAILY_DIGEST_AVATAR_URL=https://cdn.jsdelivr.net/gh/jdecked/twemoji@15.1.0/assets/72x72/1f4be.png
