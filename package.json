{
  "name": "showcase-feedback-bot",
  "version": "1.0.0",
  "description": "Discord bot for the AI Game Dev Org server: forum thread registration plus an unfarmable feedback-scoring system, with a competition mode.",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "register": "node src/register-commands.js",
    "dev": "node --watch src/index.js",
    "export:site": "node scripts/export-site-data.mjs --jams-forum 1539971669467332728",
    "migrate:projects": "node scripts/migrate-projects.mjs",
    "test": "node --test test/*.test.mjs",
    "validate:site-export": "node scripts/validate-site-export.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.119.0",
    "discord.js": "^14.16.3",
    "dotenv": "^17.4.2",
    "firebase-admin": "^14.4.0",
    "node-cron": "^4.6.0",
    "sharp": "^0.35.3"
  },
  "license": "MIT"
}
